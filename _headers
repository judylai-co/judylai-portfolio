# Cloudflare Pages — https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Content-addressed enough to cache hard: these filenames change when the work does.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# No Access-Control-Allow-Origin here on purpose: the fonts are served from
# the same origin as the CSS, so no CORS grant is needed, and a wildcard would
# let any site hotlink commercially licensed faces.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Revalidate the things that change on every edit.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate
